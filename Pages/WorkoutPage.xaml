<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutApp.Pages.WorkoutPage"
             Title="Workout Page">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="BackgroundColor" Value="{StaticResource ComponentBgColor}" />
            <Setter Property="Padding" Value="5" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout>
            <Border Background="{StaticResource TitleColor}">
                <Label
                    x:Name="workoutTitle"
                    Text="{Binding WorkoutTitle}"
                    FontSize="{StaticResource TitleFontSize}"
                    Background="{StaticResource TitleColor}"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />
            </Border>
            <!--Create a grid to hold exercises-->
            <Border>
                <Grid x:Name="exerciseGrid"
                      ColumnDefinitions="1*"
                      RowDefinitions="Auto"
                      Padding="5"
                      BackgroundColor="Black">
                </Grid>
            </Border>
            <Label x:Name="addExerciseLabel"
                    Text="Add Exercise"
                    FontSize="Small"
                    BackgroundColor="#1f1f1f"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <VerticalStackLayout Margin="10, 5, 10, 5">
                <Entry x:Name="exerciseEntry"
                       Placeholder="Enter or select exercise..."
                       TextChanged="OnExerciseTextChanged"
                       Completed="Entry_Completed">
                    <Entry.Keyboard>
                        <Keyboard x:FactoryMethod="Create">
                            <x:Arguments>
                                <KeyboardFlags>CapitalizeWord</KeyboardFlags>
                            </x:Arguments>
                        </Keyboard>
                    </Entry.Keyboard>
                </Entry>

                <!-- Autocomplete Dropdown List -->
                <Border x:Name="suggestionsBorder"
                        IsVisible="False"
                        BackgroundColor="#262626"
                        MaximumHeightRequest="180"
                        StrokeThickness="1"
                        Stroke="#3a3a3a"
                        Margin="0, -5, 0, 5">
                    <CollectionView x:Name="suggestionsView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSuggestionSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12, 10">
                                    <Label Text="{Binding Name}"
                                           TextColor="White"
                                           FontSize="15"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </VerticalStackLayout>
            <Button x:Name="deleteWorkout" Text="Delete Workout"
                    Clicked="deleteWorkoutClicked"
                    Margin="5"
                    WidthRequest="150"
                    BackgroundColor="DarkRed"/>
            <Label x:Name="statusMessageLabel"
                   BackgroundColor="#1f1f1f"
                   Text=""
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>